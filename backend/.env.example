SECRET_KEY=change-this-to-a-random-64-char-string-in-production
HMAC_SECRET=change-this-to-a-random-64-char-string-in-production
DATABASE_URL=sqlite+aiosqlite:///./leaklens.db
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
ENVIRONMENT=development
DEBUG=false

# Breach Intelligence APIs (all optional — free sources used by default)
# Get HIBP API key from https://haveibeenpwned.com/API/Key (optional, $3.50/mo)
HIBP_API_KEY=

# Optional integrations
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (optional — leave blank to disable email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@leaklens.io
